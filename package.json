{
  "name": "personal-wiki",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare 無料枠で動く一人用 Markdown wiki",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22 <25"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-css-tokens.mjs",
    "format": "biome check --write .",
    "complexity:update": "node scripts/check-complexity.mjs --update",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm --filter @personal-wiki/worker --filter @personal-wiki/editor --filter @personal-wiki/web test",
    "e2e": "pnpm --filter @personal-wiki/web test:e2e",
    "e2e:full": "pnpm --filter @personal-wiki/web test:e2e:full",
    "e2e:sheet": "pnpm --filter @personal-wiki/web e2e:sheet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
