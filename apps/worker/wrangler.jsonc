// ホスト名、D1、R2 の名前はデプロイ先ごとの設定値で、コードはこれらを参照しない。
// デプロイ先の値（routes のホスト名、database_id など）は apps/worker/deploy.env に置く。
// `pnpm deploy:remote` と `pnpm db:migrate:remote` は、この設定に deploy.env の値を重ねた
// wrangler.deploy.json（gitignore 済み）を作って wrangler に渡す。このファイルには書き込まれない。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-wiki",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 正規の URL を 1 つにし、OGP と cookie の扱いを揃える
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "wiki.example.com", "custom_domain": true }],
  // database_id はローカルでは不要で、デプロイ先の ID はここに書かない（コミットしない）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-wiki",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "personal-wiki" }],
  // apps/web のビルド出力。deploy.mjs が wrangler deploy の前にビルドする。
  // `/assets/*`（ハッシュ付きのファイル）以外は Worker が先に受け、HTML へのナビゲーションにだけ
  // Worker が index.html を返す（src/spa.ts）。未定義の /api や /mcp、fetch に SPA の HTML を返さないため。
  // not_found_handling を none にして、無い `/assets/*` には index.html でなく本文の無い 404 を返させる
  // （この 404 は Worker を通らない）。
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
    "not_found_handling": "none"
  }
}
