// ホスト名、D1、R2 の名前はデプロイ先ごとの設定値で、コードはこれらを参照しない。
// routes の wiki.example.com はデプロイする人が自分のホスト名に置き換える。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-wiki",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 正規の URL を 1 つにし、OGP と cookie の扱いを揃える
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "wiki.example.com", "custom_domain": true }],
  // database_id はローカルでは不要。wrangler deploy は未作成の D1 と R2 を作成し、database_id を
  // このファイルに書き戻すので、デプロイ先のアカウントの ID をコミットしないよう注意する
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-wiki",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "personal-wiki" }]
}
