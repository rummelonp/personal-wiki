{
  "name": "@personal-wiki/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/deploy.mjs migrate",
    "deploy:remote": "node scripts/deploy.mjs deploy",
    "api-token": "node scripts/api-token.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@personal-wiki/domain": "workspace:*",
    "@personal-wiki/markdown": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
