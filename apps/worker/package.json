{
  "name": "@personal-wiki/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env -u VITE_SITE_NAME pnpm --filter @personal-wiki/web build && wrangler dev",
    "dev:owner": "env -u VITE_SITE_NAME pnpm --filter @personal-wiki/web build && node scripts/dev-owner.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/deploy.mjs migrate",
    "deploy:remote": "node scripts/deploy.mjs deploy",
    "api-token": "node scripts/api-token.mjs",
    "derived:rebuild": "node scripts/derived-rebuild.mjs",
    "link-rewrites": "node scripts/link-rewrites.mjs",
    "backup": "node scripts/backup.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@personal-wiki/domain": "workspace:*",
    "@personal-wiki/markdown": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
