# デプロイ先ごとの値。deploy.env にコピーして書き換える（deploy.env はコミットしない）。

# Worker を置くホスト名。このホスト名の DNS ゾーンが、デプロイ先と同じ Cloudflare アカウントにあること
WIKI_HOSTNAME=wiki.example.com

# `wrangler d1 create` が表示する database_id（UUID）
D1_DATABASE_ID=
# 省略時は personal-wiki
D1_DATABASE_NAME=personal-wiki

# 省略時は personal-wiki
R2_BUCKET_NAME=personal-wiki

# アカウントが複数あるときだけ指定する
# CLOUDFLARE_ACCOUNT_ID=
