# デプロイ先ごとの値。deploy.env にコピーして書き換える（deploy.env はコミットしない）。

# Worker を置くホスト名。このホスト名の DNS ゾーンが、デプロイ先と同じ Cloudflare アカウントにあること
WIKI_HOSTNAME=wiki.example.com

# `wrangler d1 create` が表示する database_id（UUID）
D1_DATABASE_ID=
# 省略時は personal-wiki
D1_DATABASE_NAME=personal-wiki

# R2 は添付・バックアップで使う。ダッシュボードで R2 を有効にする前は、空のままでよい
# （空のあいだは、デプロイする設定から R2 の binding を外す）
R2_BUCKET_NAME=

# アカウントが複数あるときだけ指定する
# CLOUDFLARE_ACCOUNT_ID=

# owner のログイン（Cloudflare Access）。3 つとも書くか、3 つとも空にする（空なら owner はログインできない）
# Zero Trust のチーム名のホスト名（<team>.cloudflareaccess.com）
ACCESS_TEAM_DOMAIN=
# /_auth/login だけを対象にした Access のアプリケーションの Application Audience (AUD) タグ
ACCESS_AUD=
# owner として扱うメールアドレス。複数ならカンマで区切る
OWNER_EMAILS=
# セッション cookie の署名鍵 SESSION_SECRET は秘密なので、ここではなく wrangler secret put で入れる
